    {
      "type": "stat",
      "title": "Error ratio",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(pgtrace_query_errors_total{side=\"client\"}[$__rate_interval])) / clamp_min(sum(rate(pgtrace_queries_total{side=\"client\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Exact correlation",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Share of server queries linked to a client query unambiguously.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(pgtrace_correlation_total{result=\"exact\"}[$__rate_interval])) / clamp_min(sum(rate(pgtrace_correlation_total{result=~\"exact|inferred|none|orphan\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Kernel drops",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Events the BPF program could not enqueue. Should stay 0.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
