          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pgtrace_query_duration_seconds_bucket{side=\"client\"}[$__rate_interval])))",
          "legendFormat": "client p95",
          "range": true,
          "refId": "B",
