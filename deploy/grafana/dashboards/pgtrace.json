        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pgtrace_query_duration_seconds_bucket{side=\"client\"}[$__rate_interval])))",
          "legendFormat": "client p99",
          "range": true,
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(pgtrace_query_duration_seconds_bucket{side=\"server\"}[$__rate_interval])))",
          "legendFormat": "server p50",
          "range": true,
