            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pgtrace_query_duration_seconds_bucket{side=\"server\"}[$__rate_interval])))",
          "legendFormat": "server p95",
          "range": true,
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pgtrace_query_duration_seconds_bucket{side=\"server\"}[$__rate_interval])))",
          "legendFormat": "server p99",
          "range": true,
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
